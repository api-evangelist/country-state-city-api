  "info": {
    "_postman_id": "2fce1277-1c1d-4721-b572-2333d464e1d4",
    "name": "Country State City Cities States API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Country State City API exposes a global geographical reference dataset of 247+ countries, 5,000+ states / provinces, and 150,000+ cities with ISO codes, phone codes, currencies, native names, regions, sub-regions, coordinates, time zones, and flag emoji. Endpoints are read-only JSON REST resources authenticated with the X-CSCAPI-KEY header.\n\nContact Support:\n Name: Country State City API",
      "type": "text/plain"
    }
  }
